{
  "schema": "dsg.patient_clinical_context.v1",
  "purpose": "Structured clinical context for MCP-supported oral-surgical planning. Direct patient identifiers are intentionally unsupported.",
  "fields": {
    "country_code": "ISO 3166-1 alpha-2 country code",
    "age": "integer 0..125 or null",
    "sex": "F|M|OTHER|UNKNOWN",
    "smoking_status": "UNKNOWN|NEVER|FORMER|CURRENT",
    "medications": "array of medication objects",
    "conditions": "array of medical-condition objects",
    "labs": "array of dated laboratory results with units",
    "allergies": "array of strings",
    "previous_mronj": "boolean",
    "head_neck_radiotherapy": "boolean",
    "pregnancy": "boolean",
    "clinical_notes": "optional clinician notes; do not enter direct identifiers",
    "data_authority": "usually CLINICIAN_ENTERED"
  },
  "medication_fields": [
    "name", "active_ingredient", "brand_name", "dose", "route", "frequency",
    "indication", "start_date", "last_dose", "duration_months", "prescriber_specialty", "source"
  ],
  "policy": {
    "no_direct_identifiers": true,
    "no_static_treatment_rules": true,
    "live_guidance_required_for_medical_advice": true,
    "clinician_final_decision_required": true
  }
}
